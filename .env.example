# Copy to .env.local and fill in.
# Yahoo app credentials: https://developer.yahoo.com/apps/ -> your app
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Yahoo app
YAHOO_REDIRECT_URI=https://localhost:3000/api/auth/yahoo/callback

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
